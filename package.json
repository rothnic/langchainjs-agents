{
  "name": "langchainjs-agents",
  "version": "0.1.0",
  "description": "Collection of proof of concept examples for LangChainJS agents",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:unit": "vitest run --exclude='**/*.integration.test.ts'",
    "test:integration": "USE_REAL_APIS=true vitest run examples/structured-scraping/tests/agent.integration.test.ts",
    "test:integration:manual": "vitest run examples/structured-scraping/tests/agent.integration.test.ts",
    "lint": "eslint . --ext .ts,.js",
    "lint:fix": "eslint . --ext .ts,.js --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky install",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "scaffold": "node scripts/scaffold-agent.js",
    "dev:example": "tsx examples/structured-scraping/src/index.ts"
  },
  "keywords": [
    "langchain",
    "typescript",
    "agents",
    "poc",
    "scaffold",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@langchain/openai": "^1.0.0-alpha.1",
    "@langchain/langgraph": "^1.0.0-alpha.1",
    "axios": "^1.6.2",
    "cheerio": "^1.0.0-rc.12",
    "dotenv": "^16.3.1",
    "langchain": "^1.0.0-alpha.6",
    "openai": "^5.22.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@types/node": "^20.10.5",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitest/ui": "^1.0.4",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.0.1",
    "husky": "^8.0.3",
    "lint-staged": "^15.0.0",
    "msw": "^2.0.11",
    "nock": "^13.4.0",
    "prettier": "^3.1.1",
    "tsx": "^4.6.2",
    "typescript": "^5.9.2",
    "vitest": "^1.0.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
