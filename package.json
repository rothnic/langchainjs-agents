{
  "name": "langchainjs-agents",
  "version": "0.1.0",
  "description": "Collection of proof of concept examples for LangChainJS agents",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "lint": "eslint . --ext .ts,.js",
    "lint:fix": "eslint . --ext .ts,.js --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "scaffold": "node scripts/scaffold-agent.js",
    "dev:example": "tsx examples/structured-scraping/src/index.ts"
  },
  "keywords": [
    "langchain",
    "typescript",
    "agents",
    "poc",
    "scaffold",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "langchain": "^0.0.212",
    "@langchain/core": "^0.1.60",
    "@langchain/openai": "^0.0.31",
    "zod": "^3.22.4",
    "cheerio": "^1.0.0-rc.12",
    "axios": "^1.6.2",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@types/cheerio": "^0.22.35",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.0.1",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3",
    "vitest": "^1.0.4",
    "@vitest/ui": "^1.0.4",
    "tsx": "^4.6.2",
    "msw": "^2.0.11",
    "nock": "^13.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
